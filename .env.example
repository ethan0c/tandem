# Copy to .env (all optional). NEXT_PUBLIC_* values are baked in at build time, so set them
# wherever the site is built (e.g. the host's environment settings), then rebuild.

# Where the browser reaches the Socket.IO server (server.ts). Leave unset when the site and
# server run on the same host/port. Required when the site is on a static/serverless host such
# as Vercel, which cannot run server.ts: deploy server.ts elsewhere and put its URL here.
# NEXT_PUBLIC_SOCKET_URL=https://tandem-server.example.com

# Server side: origins allowed to connect when NEXT_PUBLIC_SOCKET_URL points at a separate host.
# Comma separated. Unset = same origin only.
# CORS_ORIGIN=https://www.ilovemygf.site

# TURN relay for WebRTC when a peer is behind a strict NAT or CGNAT (common on mobile data and
# some ISPs). Without it, calls between some pairs of networks never connect. Comma separated
# for several URLs. Free tiers: Cloudflare Calls TURN, Metered, ExpressTURN.
# NEXT_PUBLIC_TURN_URL=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=

# Our own relay (deploy/turn/README.md). Server-side only: the site signs short-lived relay passwords
# with TURN_SECRET, so no password ever ships in the page. Takes priority over the NEXT_PUBLIC_TURN_* setting.
# TURN_SECRET=
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:443?transport=tcp

# Discord app (/watch posts a room link in a channel or DM). From the Developer Portal → your app.
# DISCORD_PUBLIC_KEY is needed wherever the site runs (Vercel); the bot token only to register commands.
# NEXT_PUBLIC_DISCORD_APP_ID shows the "Add to Discord" button on the homepage.
# DISCORD_PUBLIC_KEY=
# NEXT_PUBLIC_DISCORD_APP_ID=
# DISCORD_APPLICATION_ID=   (for npm run discord:register)
# DISCORD_BOT_TOKEN=        (for npm run discord:register; never commit or deploy it)

# Port for server.ts (default 3000).
# PORT=3000
