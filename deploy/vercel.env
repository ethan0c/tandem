# Vercel → tandem project → Settings → Environment Variables (tick Production AND Preview),
# then Deployments → ⋯ on the latest → Redeploy. NEXT_PUBLIC_* values are baked in at build
# time, so nothing changes until that redeploy finishes.

# The Railway service URL from Settings → Networking → Generate Domain. https, no trailing slash.
NEXT_PUBLIC_SOCKET_URL=https://REPLACE-ME.up.railway.app

# Optional but recommended: the TURN relay. Copy the three values from your local .env file
# (they are not in git). Without them, calls between some network pairs never connect.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# Discord app, from the Developer Portal → your app → General Information. Then set the portal's
# "Interactions Endpoint URL" to https://www.ilovemygf.site/api/discord (after this deploy is live).
DISCORD_PUBLIC_KEY=
NEXT_PUBLIC_DISCORD_APP_ID=
