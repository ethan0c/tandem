{
  "manifest_version": 3,
  "name": "Tandem \u2013 watch together",
  "version": "0.2.0",
  "description": "Watch together with synced playback and a floating call. Expanded streaming-site support is experimental.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tandem",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.miruro.tv/*",
        "*://*.miruro.to/*",
        "*://*.miruro.online/*",
        "*://*.netflix.com/*",
        "*://*.primevideo.com/*",
        "*://*.youtube.com/*",
        "*://*.disneyplus.com/*",
        "*://*.hulu.com/*",
        "*://*.max.com/*",
        "*://*.hbomax.com/*",
        "*://*.crunchyroll.com/*",
        "*://*.tv.apple.com/*",
        "*://*.paramountplus.com/*",
        "*://*.peacocktv.com/*",
        "https://www.amazon.com/gp/video/*",
        "https://www.amazon.com/gp/aw/d/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
